# ===========================================
# Sello Environment Variables
# ===========================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# --- Server Configuration ---
PORT=3000

# --- Azure Base URL ---
# Your Azure App Service URL (used for CORS and session settings)
# Example: https://sello-bkh7dwd8avecbyd9.eastasia-01.azurewebsites.net
AZURE_BASE_URL=https://sello-bkh7dwd8avecbyd9.eastasia-01.azurewebsites.net

# --- Authentication Secret ---
# Used for signing JWT tokens (change in production)
AUTH_SECRET=your-secure-random-secret-here

# --- Session Secret ---
# Used for OAuth session management (change in production)
SESSION_SECRET=your-secure-session-secret-here

# --- Email Configuration (Gmail App Password) ---
# Get an App Password from: https://myaccount.google.com/apppasswords
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-gmail-app-password
OWNER_EMAIL=owner@example.com

# --- Google OAuth 2.0 Configuration ---
# Get credentials from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret

# Callback URL (must match exactly in Google Cloud Console)
# For Azure:
GOOGLE_CALLBACK_URL=https://sello-bkh7dwd8avecbyd9.eastasia-01.azurewebsites.net/auth/google/callback
# For local development:
# GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# --- Password Encryption Key ---
# Used for reversible password encryption (change in production)
PASSWORD_ENC_KEY=your-32-character-encryption-key